rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Users collection
    match /users/{userId} {
      allow read, write: if true;
    }

    // 2. Programs collection (Public read for discovery, Write allowed)
    match /programs/{programId} {
      allow read, write: if true;
    }

    // 3. Applications collection
    match /applications/{applicationId} {
      allow read, write: if true;
    }

    // 4. Messages collection (Direct Messaging & Messenger Chat)
    match /messages/{messageId} {
      allow read, write: if true;
    }

    // 5. Announcements collection (Admin System Broadcasts)
    match /announcements/{announcementId} {
      allow read, write: if true;
    }

    // 6. Admin Messages collection
    match /admin_messages/{msgId} {
      allow read, write: if true;
    }

    // 7. Audit Logs collection
    match /audit_logs/{logId} {
      allow read, write: if true;
    }

    // 8. Learning Resources collection
    match /learning_resources/{resourceId} {
      allow read, write: if true;
    }

    // 9. Tasks / Deliverables collection
    match /tasks/{taskId} {
      allow read, write: if true;
    }

    // 10. Meetings / Schedule collection
    match /meetings/{meetingId} {
      allow read, write: if true;
    }

    // 11. Feedback collection
    match /feedback/{feedbackId} {
      allow read, write: if true;
    }

    // 12. Notifications collection
    match /notifications/{notificationId} {
      allow read, write: if true;
    }

    // 13. Typing Status collection
    match /typing_status/{statusId} {
      allow read, write: if true;
    }
  }
}
